     def entries(
         self, limit: Optional[int] = None, provider_id: Optional[str] = None
     ) -> List[AuditEntry]:
+        if limit is not None and limit <= 0:
+            return []
         with self._lock:
             items = [e for e in self._entries if provider_id in (None, e.provider_id)]
         return items if limit is None else items[-limit:]

