+def test_import_state_skips_invalid_duplicate_and_alias_conflict(cat: ProviderCatalog) -> None:
+    existing = cat.register(make("existing", provider_id="existing1", aliases=["shared"]))
+    imported, issues = cat.import_state({"providers": [
+        {"name": "invalid", "provider_id": "bad id", "capabilities": ["text"]},
+        make("duplicate", provider_id=existing.provider_id),
+        make("conflict", provider_id="conflict1", aliases=["shared"]),
+        make("valid", provider_id="valid1"),
+    ]})
+    assert imported == 1
+    assert len(issues) == 3
+    assert cat.get("valid1").name == "valid"
+    assert cat.get("existing1").name == "existing"
+
