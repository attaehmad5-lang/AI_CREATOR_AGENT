+def test_json_formatter_preserves_json_when_scrubbing_escaped_exception() -> None:
+    fmt = JsonFormatter()
+    try:
+        raise ValueError('password=hunter2hunter2\nquote="and\nnewline')
+    except ValueError:
+        import sys
+
+        rec = logging.LogRecord("n", logging.ERROR, "f", 1, "msg", None, sys.exc_info())
+    payload = json.loads(fmt.format(rec))
+    assert "hunter2" not in payload["exception"]
+    assert "[REDACTED]" in payload["exception"]
+
