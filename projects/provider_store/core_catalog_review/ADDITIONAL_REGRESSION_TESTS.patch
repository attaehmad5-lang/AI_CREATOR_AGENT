+def test_corrupt_primary_and_backup_are_both_reported(tmp_path: Path) -> None:
+    path = tmp_path / "broken.json"
+    path.write_text("not-json", encoding="utf-8")
+    path.with_name(path.name + ".bak").write_text("also-not-json", encoding="utf-8")
+    result = JsonFileStorage(path).load()
+    assert result.records == {}
+    assert any("primary file unreadable" in issue for issue in result.issues)
+    assert any("backup unreadable" in issue for issue in result.issues)
+    assert any("corrupt file moved" in issue for issue in result.issues)
+
+
+def test_sqlite_invalid_json_row_is_skipped(tmp_path: Path) -> None:
+    path = tmp_path / "rows.db"
+    with closing(sqlite3.connect(path)) as conn:
+        with conn:
+            conn.execute(
+                "CREATE TABLE providers (provider_id TEXT PRIMARY KEY, data TEXT NOT NULL)"
+            )
+            conn.execute("INSERT INTO providers VALUES (?, ?)", ("broken", "{bad json"))
+            conn.execute(
+                "INSERT INTO providers VALUES (?, ?)",
+                ("valid", json.dumps(make("valid", provider_id="valid"))),
+            )
+    result = SqliteStorage(path).load()
+    assert result.records["valid"]["name"] == "valid"
+    assert any("invalid JSON" in issue for issue in result.issues)
+
+
