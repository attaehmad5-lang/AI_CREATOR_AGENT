+def test_configure_logging_replaces_only_owned_handlers() -> None:
+    import provider_store.observability as observability
+    logger = logging.getLogger(observability.LOGGER_NAME)
+    original = list(logger.handlers)
+    try:
+        logger.handlers.clear()
+        foreign = logging.NullHandler()
+        logger.addHandler(foreign)
+        configure_logging(stream=io.StringIO())
+        configure_logging(stream=io.StringIO())
+        assert foreign in logger.handlers
+        assert sum(bool(getattr(h, "_provider_store", False)) for h in logger.handlers) == 1
+    finally:
+        logger.handlers.clear()
+        logger.handlers.extend(original)

+def test_default_pinger_returns_success_status(monkeypatch: pytest.MonkeyPatch) -> None:
+    import provider_store.core_catalog as core_catalog
+    class Response:
+        status = 204
+        def __enter__(self) -> "Response":
+            return self
+        def __exit__(self, *args: Any) -> None:
+            return None
+    monkeypatch.setattr(core_catalog.urllib.request, "urlopen", lambda *a, **k: Response())
+    assert core_catalog.default_pinger("https://example.invalid", 0.1) == 204
