+    def get_modality_binding(self, provider_id: str) -> dict[str, Any]:
+        """Report which output modalities a provider may produce, side-effect free.
+
+        The binding comes from the provider's declared catalog category and the shared
+        ``MODALITY_CONTRACTS``/``MODALITY_OUTPUT_KINDS`` tables. If a runtime instance is
+        currently loaded it must still satisfy its callable contract; otherwise the
+        binding is invalid. No provider is contacted and nothing is persisted.
+        """
+        provider = self.get_provider(provider_id)
+        if provider is None:
+            return {"status": "NOT_FOUND", "provider": provider_id, "valid": False}
+        category = str(provider.get("category", "")).casefold().replace("-", "_").replace(" ", "_")
+        requirements = MODALITY_CONTRACTS.get(category)
+        output_kinds = MODALITY_OUTPUT_KINDS.get(category)
+        if requirements is None or output_kinds is None:
+            return {
+                "status": "UNSUPPORTED_MODALITY", "provider": provider_id, "valid": False,
+                "category": category, "contract_version": "1.0",
+            }
+        runtime_contract = "NOT_LOADED"
+        instance = self.get_loaded_provider(provider_id)
+        if instance is not None:
+            checked = self.validate_provider_contract(provider_id, instance)
+            runtime_contract = checked.get("status", "CONTRACT_VIOLATION")
+            if checked.get("valid") is not True:
+                return {
+                    "status": "CONTRACT_VIOLATION", "provider": provider_id, "valid": False,
+                    "category": category, "runtime_contract": runtime_contract,
+                    "contract_version": "1.0",
+                }
+        return {
+            "status": "VALID", "provider": provider_id, "valid": True,
+            "category": category,
+            "contract_methods": [list(alternatives) for alternatives in requirements],
+            "output_modalities": sorted(output_kinds),
+            "runtime_contract": runtime_contract,
+            "contract_version": "1.0",
+        }
+
     def load_provider(self, provider_id: str, factory: Any) -> dict[str, Any]:
diff --git a/projects/provider_store/provider_service.py b/projects/provider_store/provider_service.py
index 6d0d4f9..09bd5e1 100644
--- a/projects/provider_store/provider_service.py
+++ b/projects/provider_store/provider_service.py
@@ -832,2 +832,3 @@ class ProviderService:
         require_fresh_health_check: bool = False,
+        require_modality_binding: bool = False,
         paid_usage_approved: bool = False,
@@ -961,2 +962,63 @@ class ProviderService:
 
+        if not isinstance(require_modality_binding, bool):
+            release = self.release_unstarted_request(
+                project_id=project_id, provider_id=provider_id, request_id=request_id
+            )
+            return {
+                "status": "INVALID_MODALITY_BINDING_POLICY", "executed": False,
+                "release": release,
+            }
+        if require_modality_binding:
+            # Opt-in: the routed provider must declare a modality contract, any loaded
+            # runtime instance must still satisfy it, and the requested output modality
+            # must be one that provider's category can produce. Runs before the adapter
+            # is invoked, so a mismatch can never start (or bill) a request.
+            binding_fn = getattr(self.connection_manager, "get_modality_binding", None)
+            if not callable(binding_fn):
+                binding = {"valid": False, "status": "MODALITY_BINDING_UNAVAILABLE"}
+            else:
+                try:
+                    binding = binding_fn(provider_id)
+                except Exception as exc:
+                    binding = {
+                        "valid": False, "status": "MODALITY_BINDING_CHECK_FAILED",
+                        "error_type": type(exc).__name__,
+                    }
+            requested_modality = (
+                modality.strip().casefold() if isinstance(modality, str) else None
+            )
+            allowed_modalities = (
+                binding.get("output_modalities") if isinstance(binding, dict) else None
+            )
+            binding_valid = (
+                isinstance(binding, dict)
+                and binding.get("valid") is True
+                and isinstance(allowed_modalities, list)
+            )
+            if not binding_valid or requested_modality not in allowed_modalities:
+                release = self.release_unstarted_request(
+                    project_id=project_id, provider_id=provider_id, request_id=request_id
+                )
+                safe_binding = {
+                    "valid": False,
+                    "status": (
+                        binding.get("status") if isinstance(binding, dict)
+                        and isinstance(binding.get("status"), str)
+                        else "INVALID_MODALITY_BINDING_RESPONSE"
+                    ),
+                }
+                if binding_valid:
+                    safe_binding["category"] = binding.get("category")
+                    safe_binding["output_modalities"] = list(allowed_modalities)
+                    safe_binding["requested_modality"] = (
+                        requested_modality[:64] if requested_modality is not None else None
+                    )
+                return {
+                    "status": "MODALITY_MISMATCH" if binding_valid else "PROVIDER_MODALITY_REJECTED",
+                    "executed": False,
+                    "provider": provider_id,
+                    "modality_binding": safe_binding,
+                    "release": release,
+                }
+
         if not isinstance(require_fresh_health_check, bool):
